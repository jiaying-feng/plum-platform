/* 个人中心补充样式，通用样式见 app.wxss */
.guest-card { background: linear-gradient(140deg, #eaf4ea, #ffffff); border-color: #d5e8d5; }

.user-card {
  display: flex; align-items: center; gap: 22rpx;
  background: linear-gradient(135deg, #2f7040, #4b9b5c);
  color: #fff; border-radius: 26rpx; padding: 34rpx 28rpx; margin-bottom: 24rpx;
}
.user-card .avatar {
  width: 96rpx; height: 96rpx; flex: 0 0 96rpx; border-radius: 50%;
  background: rgba(255, 255, 255, .2); border: 2rpx solid rgba(255, 255, 255, .55);
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 700; overflow: hidden;
}
.user-body { flex: 1; min-width: 0; }
.user-name { font-size: 34rpx; }
.user-role { opacity: .85; margin-top: 4rpx; }
.user-badge { background: rgba(255, 255, 255, .2); color: #fff; flex: 0 0 auto; }

.mine-tabs { margin-bottom: 22rpx; }
.cache-note { margin: 0 4rpx 16rpx; }

.row-between { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.code {
  margin-top: 12rpx; font-size: 40rpx; font-weight: 700;
  letter-spacing: 4rpx; color: var(--green-dark);
}
.bill-actions { display: flex; gap: 16rpx; justify-content: flex-end; margin-top: 16rpx; }

.stamp-head { background: #fbf3df; border-color: #f0e2bd; }
.stamp-action { margin-top: 12rpx; }
.stamp-action .btn { margin: 0; }
.ph.thumb {
  display: flex; align-items: center; justify-content: center;
  font-size: 21rpx; letter-spacing: 0;
}

.setting-row {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  padding: 20rpx 0; border-bottom: 1rpx solid var(--line);
}
.setting-row:last-child { border-bottom: none; }
.setting-value { text-align: right; color: var(--green-dark); }
.logout-btn { color: var(--danger); border-color: #e8c8c5; }
.foot-note { text-align: center; margin: 36rpx 0 10rpx; }
