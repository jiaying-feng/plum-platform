<view class="page">

  <view wx:if="{{loading && !ready}}" class="state"><text class="spin"></text>正在把详情翻出来…</view>
  <view wx:if="{{error && !ready}}" class="error-box">
    <view class="msg">{{error}}</view>
    <button class="btn btn-primary btn-sm" bindtap="retry">再试一次</button>
  </view>

  <block wx:if="{{ready && !error}}">
    <image wx:if="{{detail.image}}" class="img img-16-9" src="{{detail.image}}" mode="aspectFill"
      binderror="onImgError" data-item="{{detail}}" />
    <view wx:else class="ph ph-2 img-16-9">{{detail.imageText}}</view>

    <view class="card" style="margin-top:20rpx">
      <view style="display:flex;justify-content:space-between;align-items:center">
        <text class="bold" style="font-size:34rpx">{{detail.name || detail.title}}</text>
        <text class="badge">{{typeName}}</text>
      </view>
      <view class="small muted" style="margin-top:8rpx">{{desc}}</view>
      <view class="price" style="font-size:36rpx;margin-top:10rpx">{{priceText}}</view>
      <view wx:if="{{fromCache && !loading}}" class="small muted" style="margin-top:6rpx">当前为本地缓存内容</view>
    </view>

    <view class="card">
      <view class="bold" style="margin-bottom:8rpx">说两句</view>
      <view class="small">{{detail.intro || '自家做的，慢慢逛，别赶时间。'}}</view>
      <view wx:if="{{type == 'orchard'}}" class="small muted" style="margin-top:10rpx">
        {{detail.open_time}} 开门 · 门票含两斤梅子带走
      </view>
      <view wx:if="{{type == 'product'}}" class="small muted" style="margin-top:10rpx">
        库里 {{detail.stock}} 件 · 已售 {{detail.sales}} 件
      </view>
      <view wx:if="{{type == 'research'}}" class="small muted" style="margin-top:10rpx">
        还剩 {{detail.capacity - detail.signed}} 个名额
      </view>
    </view>

    <button class="btn btn-block" bindtap="aiTalk">生成一段语音讲解稿</button>
    <view wx:if="{{talk}}" class="card" style="margin-top:16rpx">
      <view class="bold">{{talk.title}}</view>
      <view wx:for="{{talk.segments}}" wx:key="*this" class="bubble" style="margin-top:12rpx">{{item}}</view>
    </view>
  </block>
</view>

<view wx:if="{{ready && !error}}" class="bottom-bar">
  <button class="btn fav-btn {{fav ? 'btn-ghost' : ''}}" bindtap="toggleFav">{{fav ? '已收好' : '收着'}}</button>
  <button class="btn btn-primary main-btn" bindtap="openSheet">
    {{type == 'product' ? '买一件' : (type == 'orchard' ? '约一场' : (type == 'research' ? '报个名' : '订一晚'))}}
  </button>
</view>

<view wx:if="{{sheet}}" class="mask" bindtap="closeSheet">
  <view class="sheet" catchtap="stopBubble">
    <view class="sheet-title">{{typeName}} · 办一下手续</view>

    <view wx:if="{{result}}" class="card" style="background:#eaf4ea;border-color:#cfe5cf">
      <view class="bold">{{result.tip || '办好了，到场出示核销码'}}</view>
      <view class="small">单号 {{result.order_no || result.code}}</view>
      <view class="small">金额 ¥{{result.amount}} · {{result.status}}</view>
      <view wx:if="{{result.checkin_code}}" class="bold" style="font-size:38rpx;letter-spacing:3rpx;margin-top:10rpx">
        {{result.checkin_code}}
      </view>
    </view>

    <block wx:else>
      <block wx:if="{{type == 'orchard'}}">
        <view class="field"><view class="label">选一场</view>
          <picker range="{{sessionLabels}}" value="{{form.sessionIndex}}" bindchange="onSession">
            <view class="input">{{sessionLabels[form.sessionIndex] || '暂时没排场次'}}</view>
          </picker></view>
        <view class="form-row">
          <view class="field"><view class="label">几个人（1-20）</view>
            <input class="input" type="number" value="{{form.people}}" data-field="people" bindinput="onField" /></view>
          <view class="field"><view class="label">联系人</view>
            <input class="input" value="{{form.contact}}" data-field="contact" bindinput="onField" /></view>
        </view>
      </block>

      <block wx:if="{{type == 'research'}}">
        <view class="form-row">
          <view class="field"><view class="label">几个人（1-10）</view>
            <input class="input" type="number" value="{{form.people}}" data-field="people" bindinput="onField" /></view>
          <view class="field"><view class="label">联系人</view>
            <input class="input" value="{{form.contact}}" data-field="contact" bindinput="onField" /></view>
        </view>
      </block>

      <block wx:if="{{type == 'homestay'}}">
        <view class="field"><view class="label">房型</view>
          <picker range="{{roomLabels}}" value="{{form.roomIndex}}" bindchange="onRoom">
            <view class="input">{{roomLabels[form.roomIndex] || '暂时没有房型'}}</view>
          </picker></view>
        <view class="form-row">
          <view class="field"><view class="label">入住</view>
            <picker mode="date" value="{{form.checkIn}}" data-field="checkIn" bindchange="onDate">
              <view class="input">{{form.checkIn}}</view></picker></view>
          <view class="field"><view class="label">离店</view>
            <picker mode="date" value="{{form.checkOut}}" data-field="checkOut" bindchange="onDate">
              <view class="input">{{form.checkOut}}</view></picker></view>
        </view>
        <view class="field"><view class="label">住几个人</view>
          <input class="input" type="number" value="{{form.guests}}" data-field="guests" bindinput="onField" /></view>
        <view class="field"><view class="label">联系人</view>
          <input class="input" value="{{form.contact}}" data-field="contact" bindinput="onField" /></view>
      </block>

      <block wx:if="{{type == 'product'}}">
        <view class="field"><view class="label">买几件</view>
          <input class="input" type="number" value="{{form.quantity}}" data-field="quantity" bindinput="onField" /></view>
        <view class="form-row">
          <view class="field"><view class="label">收货人</view>
            <input class="input" value="{{form.receiver}}" data-field="receiver" bindinput="onField" /></view>
          <view class="field"><view class="label">手机号</view>
            <input class="input" type="number" maxlength="11" value="{{form.phone}}" data-field="phone" bindinput="onField" /></view>
        </view>
        <view class="field"><view class="label">寄到哪儿</view>
          <input class="input" value="{{form.address}}" data-field="address" bindinput="onField" /></view>
      </block>

      <view wx:if="{{type != 'product'}}" class="field"><view class="label">手机号（11 位）</view>
        <input class="input" type="number" maxlength="11" value="{{form.phone}}" data-field="phone" bindinput="onField" /></view>

      <button class="btn btn-primary btn-block" bindtap="submit" disabled="{{submitting}}">
        {{submitting ? '正在办…' : '就这么办'}}
      </button>
      <button wx:if="{{type == 'product'}}" class="btn btn-block" style="margin-top:14rpx"
        bindtap="addCart" disabled="{{submitting}}">只放进购物车</button>
    </block>

    <button class="btn btn-block" style="margin-top:16rpx" bindtap="closeSheet">关掉</button>
  </view>
</view>
