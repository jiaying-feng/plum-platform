# ---------------------------------------------------------------------------
# AI 扩展域配置模板：复制本文件为同目录下的 ai.env，按实际情况填写后重启服务。
# 优先级：系统环境变量 > ai.env > 内置默认值。ai.env 含密钥，请勿提交到版本库。
# 不创建 ai.env 时，外部大模型与 MySQL 全部关闭，原有零依赖、断网可跑链路完全不变。
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# 【推荐 · 零成本起步】智谱 BigModel / GLM-4-Flash-250414（长期免费模型）
# 免费模型说明：https://docs.bigmodel.cn/cn/guide/models/free/glm-4-flash-250414
# 接口与认证：  https://docs.bigmodel.cn/cn/guide/develop/http/introduction
# 注册与密钥：  https://bigmodel.cn → 用户中心 API Keys（需实名认证，密钥只显示一次）
# 兼容 OpenAI Chat Completions + Authorization: Bearer，本项目零代码改动，只改 4 行：
#   LLM_ENABLED=1
#   LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
#   LLM_API_KEY=<你的智谱 API Key>
#   LLM_MODEL=glm-4-flash-250414
# 免费档按模型设并发限制（高峰期可能 429），模型 ID 会换代，以控制台免费模型区为准。
# ---------------------------------------------------------------------------

# ===== 1. 外部大模型（OpenAI 兼容 Chat Completions）=====
# 总开关：0=关闭（默认），1=启用。启用前请确认 LLM_API_BASE 与 LLM_API_KEY 已填。
LLM_ENABLED=0
# 接口地址：填到 /v1 为止，客户端自动拼 /chat/completions；也可直接填完整 URL。
# OpenAI:        https://api.openai.com/v1
# 通义千问兼容:  https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek:      https://api.deepseek.com/v1
# 智谱 GLM(免费): https://open.bigmodel.cn/api/paas/v4
# 本地 Ollama:   http://127.0.0.1:11434/v1
LLM_API_BASE=https://api.openai.com/v1
# 若厂商路径不是 /chat/completions，在这里改（Azure / 自建网关常用）
LLM_CHAT_PATH=/chat/completions
# 密钥：只写在 ai.env 或系统环境变量里，接口 /api/ai/config 只返回脱敏提示
LLM_API_KEY=
# 认证头：默认 Authorization: Bearer <key>；Azure 可改成 api-key + 空前缀
LLM_API_KEY_HEADER=Authorization
LLM_API_KEY_PREFIX=Bearer
# 模型名，由厂商决定
LLM_MODEL=gpt-4o-mini
# 请求参数
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=400
LLM_EXTRA_BODY=
# 追加到 system prompt 的补充要求（可留空）
LLM_SYSTEM_PROMPT=
# 网络与稳定性
LLM_TIMEOUT=12
LLM_RETRY=0
LLM_MAX_HISTORY=6
LLM_MAX_ANSWER_CHARS=600

# ===== 2. MySQL（AI 问答会话 / 消息 / 调用日志）=====
# 总开关：0=关闭（用进程内内存历史），1=启用。启用前先建好库：python tools/init_ai_db.py
MYSQL_ENABLED=0
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=plum_ai
MYSQL_CHARSET=utf8mb4
MYSQL_TIMEOUT=5
